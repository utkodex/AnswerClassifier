# jev (TypeSafe decision model): answers single/multi-choice and yes/no questions
TYPESAFE_API_KEY=
# Optional override (default jev-latest)
JOBANSWER_JEV_MODEL=

# Optional: Claude writes essay / free-text answers the rules can't cover
ANTHROPIC_API_KEY=
# Optional override (default claude-opus-5-5)
JOBANSWER_MODEL=

# Optional: jev model for src/category_classifier (default jev-latest)
CATEGORY_CLASSIFIER_MODEL=
# Optional: jev model for src/sub_category_classifier (falls back to CATEGORY_CLASSIFIER_MODEL)
SUB_CATEGORY_CLASSIFIER_MODEL=
